---
import '../styles/global.css';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fatayat NU - Portal Berita & Kegiatan</title>
  </head>
  <body class="bg-gray-50 text-gray-800 font-sans">
    
        <!-- Navbar Hijau Khas Fatayat -->
    <header class="bg-[#006837] text-white shadow-md sticky top-0 z-50">
      <div class="max-w-5xl mx-auto px-4 py-4 flex justify-between items-center">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center text-[#006837] font-bold">
            FNU
          </div>
          <div>
            <h1 class="font-bold text-lg leading-tight text-white m-0">FATAYAT NU</h1>
            <p class="text-xs text-green-200 m-0">Pemudi Nahdlatul Ulama</p>
          </div>
        </div>
        <nav class="space-x-6 text-sm font-medium">
          <a href="/" class="text-white no-underline hover:text-yellow-300 transition">Beranda</a>
          <a href="/profil" class="text-white no-underline hover:text-yellow-300 transition">Profil</a>
          <a href="/blog" class="text-white no-underline hover:text-yellow-300 transition">Kegiatan</a>
        </nav>
      </div>
    </header>

    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-[#006837] to-[#1B5E20] text-white py-14 px-4">
      <div class="max-w-5xl mx-auto text-center">
        <span class="bg-yellow-400 text-[#006837] text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
          Website Resmi Organisasi
        </span>
        <h2 class="text-3xl md:text-4xl font-extrabold mt-4 mb-3 text-white">
          Berdaya, Mandiri, dan Peduli Sesama
        </h2>
        <p class="text-green-100 max-w-2xl mx-auto text-sm md:text-base">
          Pusat informasi kegiatan, program kerja, dan dakwah kemasyarakatan Pimpinan Fatayat Nahdlatul Ulama.
        </p>
      </div>
    </section>


    <!-- Daftar Berita & Kegiatan Terbaru -->
    <main class="max-w-5xl mx-auto px-4 py-12">
      <div class="flex justify-between items-center mb-8 border-b-2 border-[#006837] pb-2">
        <h3 class="text-2xl font-bold text-[#006837]">Kabar & Kegiatan Terbaru</h3>
        <a href="/blog" class="text-sm text-[#006837] font-semibold hover:underline">Lihat Semua →</a>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {posts.slice(0, 6).map((post) => {
          const imgSrc = typeof post.data.heroImage === 'string' 
            ? post.data.heroImage 
            : post.data.heroImage?.src;
            
          return (
            <article class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition">
              {imgSrc && (
                <img 
                  src={imgSrc} 
                  alt={post.data.title} 
                  class="w-full h-44 object-cover"
                />
              )}
              <div class="p-5">
                <p class="text-xs text-green-700 font-semibold mb-1">
                  {new Date(post.data.pubDate).toLocaleDateString('id-ID', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                  })}
                </p>
                <h4 class="font-bold text-lg text-gray-900 mb-2 line-clamp-2">
                  <a href={`/blog/${post.id}/`} class="hover:text-[#006837]">
                    {post.data.title}
                  </a>
                </h4>
                <p class="text-sm text-gray-600 line-clamp-3 mb-4">
                  {post.data.description}
                </p>
                <a 
                  href={`/blog/${post.id}/`} 
                  class="inline-block text-xs font-bold text-[#006837] hover:underline"
                >
                  Baca Selengkapnya →
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </main>

    <!-- Footer -->
    <footer class="bg-[#004d29] text-green-100 py-8 mt-12 text-center text-sm">
      <p class="font-semibold text-white">Pimpinan Fatayat Nahdlatul Ulama</p>
      <p class="text-xs mt-1 text-green-300">© {new Date().getFullYear()} Hak Cipta Dilindungi.</p>
    </footer>

  </body>
</html>
